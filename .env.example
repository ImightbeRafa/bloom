# ─── Bloom — Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values

# Tilopay Configuration
TILOPAY_BASE_URL=https://app.tilopay.com/api/v1
TILOPAY_API_KEY=
TILOPAY_USER=
TILOPAY_PASSWORD=
TILOPAY_WEBHOOK_SECRET=
ORDER_DATA_SECRET=
ALLOW_UNSIGNED_TILOPAY_WEBHOOKS=false
REQUIRE_SIGNED_RETURN_DATA=true

# Resend Email
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=

# Betsy CRM
BETSY_API_KEY=
BETSY_API_URL=https://www.betsycrm.com/api/integration/orders/create

# Meta Pixel + Conversions API
META_PIXEL_ID=2410372076145656
META_CAPI_ACCESS_TOKEN=

# Application
APP_URL=https://bloomcr.shopping
